{
  "name": "@pipetwin/headless-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node CLI running the same TS physics + diagnostics for batch scenarios, datasets and benchmarks.",
  "bin": {
    "pipetwin-runner": "./dist/pipetwin-runner.mjs"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/pipetwin-runner.mjs --log-level=warning",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@pipetwin/contracts": "0.1.0",
    "@pipetwin/physics-core": "0.1.0",
    "@pipetwin/diagnostics-core": "0.1.0"
  }
}
